[Desktop Entry]
Name=thumbpad
Comment=Swipe-gesture on-screen keyboard
Exec=@CMAKE_INSTALL_PREFIX@/bin/thumbpad
Type=Application
Icon=input-keyboard-virtual
NoDisplay=true
X-KDE-Wayland-VirtualKeyboard=true
# Restricted KWin protocol: lets the keyboard appear on the lock screen.
X-KDE-Wayland-Interfaces=kde_lockscreen_overlay_v1
